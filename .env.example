# Copy to .env — GitHub Actions では Repository secrets に登録

# Notion Internal Integration（必須）
NOTION_TOKEN=

# タイムカードのデータベース ID（必須）
NOTION_DATABASE_ID=

# Google サービスアカウント JSON を **1行の JSON 文字列**（必須）
# ローカルではファイルを読み込む場合はシェルで export するか、改行を除いた JSON を貼る
GOOGLE_SERVICE_ACCOUNT_JSON=

# ログを書き込むスプレッドシート ID（URL の /d/ と /edit の間）（必須）
SPREADSHEET_ID=

# 任意（既定: Sheet1 / Config）
SHEET_NAME=
CONFIG_SHEET_NAME=

# 初回のみ Config!A1 が空のとき、何日前から Notion を取得するか（既定: 7）
INITIAL_SYNC_DAYS=7

# プロパティ名が DB と違う場合のみ上書き（任意）
# NOTION_PROP_NAME=Name
# NOTION_PROP_DATE_START=日付（開始）
# NOTION_PROP_DATE_END=終了時間(ボタン用)
# NOTION_PROP_STAFF=スタッフ
# NOTION_PROP_BREAK=途中休憩（分）
# NOTION_PROP_TRANSPORT=交通費
# NOTION_PROP_ID=ID
